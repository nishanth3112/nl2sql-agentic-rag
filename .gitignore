eval/results.csv

.pytest_cache/

# Chroma store for demo uploads. Defaults to a temp directory (see
# src/uploads.py CHROMA_DIR) so it never lands here at all; this covers pointing
# UPLOAD_CHROMA_DIR at the project during development. chroma_db/ itself IS
# committed -- it is the shipped index, and the deployed app cannot rebuild it.
chroma_uploads/

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
terraform/.terraform.lock.hcl

# Real k8s secret (only the .example template should ever be committed)
k8s/01-secret.yaml
dev_20240627/
.DS_Store

# Snowflake key-pair auth material. The keys live outside the repo by default
# (~/.snowflake/), but never let a copy land in a commit.
*.p8
*.pub

# dbt build artifacts. Regenerated on every `dbt run`/`dbt build`; the
# compiled SQL under target/ is derived from models/, and logs/ is per-run
# output. Neither is source.
dbt_project/target/
dbt_project/logs/

# Airflow runtime state. Same reasoning as dbt_project/target/: regenerated by
# the containers, not source. dags/, docker-compose.yaml and Dockerfile ARE
# tracked -- they are the pipeline definition.
airflow/logs/
airflow/plugins/
airflow/config/

# Power BI files live outside the repo (binary, embeds connection config)
*.pbix
