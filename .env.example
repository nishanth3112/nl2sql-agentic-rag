# Copy to .env and fill in the keys for whichever providers you route to.
#   cp .env.example .env
# Every value below is optional except the API keys for the providers actually
# in use -- src/config.py supplies the defaults shown in comments.

# --- API keys -----------------------------------------------------------
# You only need keys for the providers referenced by the *_PROVIDER settings
# below. With the defaults as shipped, that's OpenAI (planner + generator) and
# Groq (classifier).
OPENAI_API_KEY=
GROQ_API_KEY=
# Gemini is fully wired up but its free tier allows 20 requests PER DAY, which
# is unusable for the 500-question benchmark. Leave blank unless you route to it.
GEMINI_API_KEY=

# --- Per-role provider + model ------------------------------------------
# Mix and match across the three providers in src/llm_providers.py. The
# classifier only picks one of four labels, so a small fast model is the right
# call there; the planner and generator do the actual reasoning.
PLANNER_PROVIDER=openai
PLANNER_MODEL=gpt-5-mini

GENERATOR_PROVIDER=openai
GENERATOR_MODEL=gpt-5-mini

CLASSIFIER_PROVIDER=groq
# llama-3.1-8b-instant was retired by Groq; results measured on it are kept in
# the README as a prior result.
CLASSIFIER_MODEL=openai/gpt-oss-20b

# --- Paths --------------------------------------------------------------
BENCHMARK_DATA_PATH=./data/bird-mini-dev
CHROMA_PERSIST_DIR=./chroma_db

# --- Behaviour ----------------------------------------------------------
# Correction-loop attempts before giving up.
MAX_RETRIES=3

# BIRD's `evidence` field is a human-written hint that often contains the
# answer's formula. Left false so results are schema-only and comparable to
# the 44.20% reported in the README.
INCLUDE_EVIDENCE_IN_PROMPTS=false

# Reasoning models spend tokens thinking before emitting output, and the cap
# covers both. Too low and the model returns an empty string with no error.
REASONING_TOKEN_BUDGET=3000

# Per-node OpenTelemetry spans, one JSON line each, written to a local file.
# Off by default. Nothing is sent anywhere.
TRACING_ENABLED=false
TRACE_EXPORT_PATH=./logs/spans.jsonl

# --- Optional services --------------------------------------------------
# Schema-retrieval cache. Absent Redis is handled gracefully, not fatal.
REDIS_URL=redis://localhost:6379/0

# --- UI -----------------------------------------------------------------
# true runs the graph in-process and ignores API_URL -- how the hosted
# single-process demo runs. false calls the FastAPI backend instead.
UI_DIRECT_MODE=false
API_URL=http://localhost:8000

# Caps for a publicly hosted demo, to bound API spend. Off by default.
DEMO_LIMITS_ENABLED=false
DEMO_SESSION_LIMIT=5
DEMO_DAILY_LIMIT=120

# --- Visitor SQLite uploads (ui/app.py -> src/uploads.py) ----------------
# Uploads are session-scoped and land in the OS temp directory. The size cap
# exists because the demo host has ~1GB of memory; the concurrency cap and TTL
# are what stop uploads accumulating until it OOMs. Uploaded databases are
# always queried read-only.
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_CONCURRENT=3
UPLOAD_TTL_SECONDS=3600
# Override the storage directory (defaults to a subdirectory of the temp dir).
# UPLOAD_DIR=
# Chroma store for upload embeddings. Deliberately NOT chroma_db/, which is the
# committed shipped index the deployed app cannot rebuild. Defaults inside
# UPLOAD_DIR so a database and its embeddings share one lifecycle.
# UPLOAD_CHROMA_DIR=

# --- Benchmark ----------------------------------------------------------
# Which committed split to run: calibration (150), heldout (350) or all (500, the default).
# BENCHMARK_SPLIT=heldout
# Caps the questions inside that split. A quick plumbing check, never a result.
# BENCHMARK_LIMIT=50
# Each run writes eval/results_<timestamp>.csv and refuses an existing file. To continue an
# interrupted run, point this at its file and set BENCHMARK_RESUME=1 (or pass --resume).
# BENCHMARK_RESULTS_PATH=
# BENCHMARK_RESUME=1
